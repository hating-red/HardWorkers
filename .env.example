# Боевой домен без слэша на конце — попадает в canonical, sitemap.xml и robots.txt
NUXT_PUBLIC_SITE_URL=https://example.com

# Коды подтверждения из Яндекс Вебмастера и Google Search Console (необязательно)
NUXT_PUBLIC_YANDEX_VERIFICATION=
NUXT_PUBLIC_GOOGLE_VERIFICATION=

# Номер счетчика Яндекс Метрики (необязательно)
NUXT_PUBLIC_METRIKA_ID=
